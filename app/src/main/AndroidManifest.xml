<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        These three exist only so KeepAliveService can hold an ongoing
        notification. None of them grants access to data: none maps to a
        supplementary GID, and none is a runtime data permission.

        INTERNET is deliberately still absent, which is what keeps "nothing it
        reads can leave the device" a kernel-enforced fact rather than a
        promise. See SECURITY.md.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Lets the app show the platform's own "allow this app to ignore battery
        optimisations?" dialog. That dialog sets exactly the value the setup
        check reads, so the fix and the check are the same thing — the plain
        settings-list action does not correspond to what every skin actually
        shows the user, which left the check red after an apparent fix.

        Grants no access to data.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
        Package visibility for the one app this interoperates with. Without it
        getPackageInfo cannot see YouTube on API 30+, so the preflight check
        "is YouTube installed" would report a false negative.

        This grants no ability to read anything from YouTube; it only lifts the
        default filtering that would otherwise hide the package's existence.
    -->
    <queries>
        <package android:name="com.google.android.youtube" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            exported="true" is required: the binder is system_server, which lives
            outside this app. It is gated by BIND_ACCESSIBILITY_SERVICE, a
            signature-level permission only the system holds, so nothing else on
            the device can bind to this service.
        -->
        <!--
            stopWithTask="false" keeps the service alive when the app's task is
            swiped out of Recents. (It is also the platform default; stated
            explicitly because it is load-bearing here, not incidental.)

            This deliberately runs in the app's main process, alongside
            KeepAliveService. A separate ":accessibility" process was tried and
            removed: vendor cleaners sweep per package, not per process, so it
            killed both anyway, while costing a second ART runtime. The ongoing
            notification is what actually protects the process now, and it can
            only do that for the process it lives in.

            A user-invoked Force stop remains terminal and cannot be bypassed
            by an ordinary app.
        -->
        <service
            android:name=".SkipAdAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:stopWithTask="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
            exported="false": nothing outside this app ever needs to start it.
            It is started by SkipAdAccessibilityService when that service
            connects, and stopped when it disconnects.

            specialUse is the honest type. The platform's typed categories
            (mediaPlayback, dataSync, location, ...) all describe work this
            service does not do; it holds a notification and nothing else.
        -->
        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the accessibility service's process resident so vendor memory cleaners do not silently stop ad skipping." />
        </service>

    </application>

</manifest>
