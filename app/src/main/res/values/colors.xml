<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launcher icon: white glyph on near-black. -->
    <color name="ic_launcher_background">#FF0F0F0F</color>

    <!--
        Light palette. values-night/colors.xml redefines every one of these for
        dark mode; the app theme is DeviceDefault.DayNight, so both are live.
        Adding a colour here means adding it there too, or it will read as
        black-on-black at night.
    -->
    <color name="surface">#FFFFFFFF</color>
    <color name="surface_card">#FFF6F7F9</color>
    <color name="outline">#FFDFE3E8</color>

    <color name="text_primary">#FF14161A</color>
    <color name="text_secondary">#FF5B626D</color>
    <color name="text_on_accent">#FFFFFFFF</color>

    <color name="accent">#FF2F6BF3</color>
    <color name="accent_disabled">#FFC7CCD4</color>

    <color name="state_ok">#FF17803D</color>
    <color name="state_warn">#FFB45309</color>
    <color name="state_bad">#FFC02626</color>

    <color name="state_ok_bg">#1A17803D</color>
    <color name="state_warn_bg">#1AB45309</color>
    <color name="state_bad_bg">#1AC02626</color>
</resources>
