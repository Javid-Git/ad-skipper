<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        No action bar: the screen draws its own large title, and the default bar
        put "Ad Skipper" on screen twice. DayNight is kept so the palette in
        values-night still applies.
    -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/surface</item>
    </style>

    <!--
        Small caps section label above each card. Defined once so the three
        headings cannot drift apart.
    -->
    <style name="SectionHeading">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>
