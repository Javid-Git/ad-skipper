<?xml version="1.0" encoding="utf-8"?>
<!--
    Scopes the service as tightly as the platform allows.

    packageNames        - accessibility events are delivered for YouTube only.
                          The adaptive monitor separately checks window package
                          names so it can find YouTube PiP without reading other
                          apps' trees.
    accessibilityFlags  - flagReportViewIds populates getViewIdResourceName(),
                          which is the most stable way to spot the skip button.
                          flagIncludeNotImportantViews is needed because the
                          clickable ancestor of the label is sometimes marked
                          not-important-for-accessibility, which would otherwise
                          hide it from the node tree entirely.
                          flagRetrieveInteractiveWindows lets the service find
                          YouTube's picture-in-picture window when another app
                          owns the active window.
                          canPerformGestures enables the exact-bounds fallback
                          for YouTube controls that refuse ACTION_CLICK.
    notificationTimeout - coalesces YouTube's very chatty content-change events;
                          polling remains the safety net when events are sparse.
    isAccessibilityTool - declares what this actually is: a service whose whole
                          purpose is performing an interaction on behalf of
                          someone who cannot perform it themselves. It is not a
                          claim made for the sake of it — pressing Skip Ad is
                          the only thing this service does. The platform uses it
                          to decide how the service is presented in Settings,
                          and it is what separates a genuine assistive tool from
                          an app that merely holds the same permission.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowContentChanged|typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagIncludeNotImportantViews|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="true"
    android:isAccessibilityTool="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100"
    android:packageNames="com.google.android.youtube"
    android:settingsActivity="dev.javid.adskipper.MainActivity" />
